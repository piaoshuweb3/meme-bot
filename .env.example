####################################################################
# meme-bot 环境变量模板
#
# ⚠️ 安全基线：
#   1. 本文件只放占位符，任何真实密钥都不得写入仓库；
#   2. 复制为 .env 后填入真实值，.env 已在 .gitignore 中排除；
#   3. 私钥令牌使用后请立即从配置/remote 中移除；
#   4. 生产环境请使用 KMS / Vault，而不是明文文件。
####################################################################

# ---- 运行模式：dry_run（默认，不下真实单）| live ----
MEMEBOT_MODE=dry_run

# ---- HTTP 服务 ----
MEMEBOT_SERVER_PORT=8080
MEMEBOT_SERVER_GIN_MODE=release

# ---- PostgreSQL ----
MEMEBOT_DATABASE_DSN=postgres://bot:botpass@localhost:5432/smartmoney?sslmode=disable

# ---- Redis ----
MEMEBOT_REDIS_ADDR=localhost:6379
MEMEBOT_REDIS_PASSWORD=
MEMEBOT_REDIS_DB=0

# ---- Telegram（实时监控端）----
MEMEBOT_TELEGRAM_ENABLED=false
MEMEBOT_TELEGRAM_TOKEN=
MEMEBOT_TELEGRAM_CHAT_ID=0

# ---- 链：RPC 与聚合器（占位符，按需替换）----
MEMEBOT_CHAINS_BASE_RPC_URLS=https://mainnet.base.org
MEMEBOT_CHAINS_BASE_AGGREGATOR_API_KEY=
MEMEBOT_CHAINS_SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
MEMEBOT_CHAINS_SOLANA_AGGREGATOR_API_KEY=

# ---- 钱包（⚠️ 默认留空；dry_run 模式下不需要）----
# 生产环境用 KMS/Vault 注入，切勿写入文件后再提交
MEMEBOT_CHAINS_BASE_PRIVATE_KEY=
MEMEBOT_CHAINS_SOLANA_PRIVATE_KEY=

# ---- 外部数据源 API Key（按需开启）----
MEMEBOT_PROVIDERS_GOPLUS_API_KEY=
MEMEBOT_PROVIDERS_BIRDEYE_API_KEY=
MEMEBOT_PROVIDERS_MORALIS_API_KEY=
MEMEBOT_PROVIDERS_BITQUERY_API_KEY=
MEMEBOT_PROVIDERS_DEXSCREENER_ENABLED=true

# ---- LLM Agent ----
MEMEBOT_AGENT_ENABLED=false
MEMEBOT_AGENT_PROVIDER=openai
MEMEBOT_AGENT_MODEL=gpt-4o-mini
MEMEBOT_AGENT_API_KEY=
MEMEBOT_AGENT_BASE_URL=
MEMEBOT_AGENT_MAX_STEPS=12

# ---- 鉴权 ----
MEMEBOT_AUTH_JWT_SECRET=change-me-in-production

# ---- 支付回调（HMAC-SHA256 验签；留空时 /api/v1/payments/webhook 拒绝所有请求）----
MEMEBOT_PAYMENT_WEBHOOK_SECRET=
# 支付渠道标识：generic | stripe | usdc
MEMEBOT_PAYMENT_PROVIDER=generic
# 回调时间戳容忍窗口（秒），防重放；0 = 关闭时间戳校验
MEMEBOT_PAYMENT_TOLERANCE_SECONDS=300

# ---- 私有交易通道 ----
MEMEBOT_PRIVATE_TX_BASE_RPC=https://rpc.flashbots.net
MEMEBOT_PRIVATE_TX_SOLANA_RPC=
