            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "信号漏斗（每分钟）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(memebot_signals_total[5m]) * 60",
          "legendFormat": "生成"
        },
        {
          "refId": "B",
          "expr": "rate(memebot_signals_filtered_total[5m]) * 60",
          "legendFormat": "被过滤"
        },
        {
          "refId": "C",
          "expr": "rate(memebot_swaps_observed_total[5m]) * 60",
          "legendFormat": "Swap 观测"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
